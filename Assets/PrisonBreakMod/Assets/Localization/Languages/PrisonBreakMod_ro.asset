  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: PrisonBreakMod_ro
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: ro
  m_SharedData: {fileID: 11400000, guid: 09105430001d7424a9c35ff9ec274c87, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 159430135808
    m_Localized: "Evadare din pu\u015Fc\u0103rie"
    m_Metadata:
      m_Items: []
  - m_Id: 253495791616
    m_Localized: "Dup\u0103 ce ai fost capturat de GlorpCo, trebuie s\u0103 scapi!"
    m_Metadata:
      m_Items: []
  - m_Id: 519808929792
    m_Localized: Izbucni
    m_Metadata:
      m_Items: []
  - m_Id: 411806946742272
    m_Localized: "Agent, m\u0103 auzi? Trebuie s\u0103 ie\u0219i de acolo."
    m_Metadata:
      m_Items: []
  - m_Id: 412025037967360
    m_Localized: "Nici m\u0103car nu o s\u0103 te \xEEntreb cum ai ob\u021Binut comunicatorul
      prin securitate..."
    m_Metadata:
      m_Items: []
  - m_Id: 412350331408384
    m_Localized: "Un ofi\u021Ber vine s\u0103 te interogheze, acesta va fi biletul
      t\u0103u de ie\u0219ire din celul\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 412490337275904
    m_Localized: "Fi\u021Bi aten\u021Bi, securitatea de aici este pu\u021Bin diferit\u0103
      de cea cu care sunte\u021Bi obi\u0219nui\u021Bi."
    m_Metadata:
      m_Items: []
  - m_Id: 412565033635840
    m_Localized: "Orice u\u0219i verzi func\u021Bioneaz\u0103 a\u0219a cum v-a\u021Bi
      a\u0219tepta, pur \u0219i simplu atinge\u021Bi zona central\u0103 \u0219i se
      vor deschide."
    m_Metadata:
      m_Items: []
  - m_Id: 412884417302528
    m_Localized: "Pe de alt\u0103 parte, u\u0219ile albastre nu pot fi deschise \xEEn
      mod normal."
    m_Metadata:
      m_Items: []
  - m_Id: 412982119419904
    m_Localized: "Dac\u0103 pute\u021Bi g\u0103si un terminal de acces, ar trebui
      s\u0103 pute\u021Bi deschide aceste u\u0219i."
    m_Metadata:
      m_Items: []
  - m_Id: 413095067832320
    m_Localized: "Paznicul se apropie, tu te treze\u0219ti.\nSucces agent."
    m_Metadata:
      m_Items: []
  - m_Id: 22367388935049216
    m_Localized: Evadare!
    m_Metadata:
      m_Items: []
  - m_Id: 22367773938601984
    m_Localized: "G\u0103si\u021Bi o modalitate de a sc\u0103pa din unitate"
    m_Metadata:
      m_Items: []
  - m_Id: 22367938804109312
    m_Localized: "P\u0103stra\u021Bi un profil sc\u0103zut..."
    m_Metadata:
      m_Items: []
  - m_Id: 22368139904208896
    m_Localized: "Evada\u021Bi f\u0103r\u0103 a alerta securitatea"
    m_Metadata:
      m_Items: []
  - m_Id: 22368273358573568
    m_Localized: CV the Ward
    m_Metadata:
      m_Items: []
  - m_Id: 22369034335342592
    m_Localized: Cauza ceva haos!
    m_Metadata:
      m_Items: []
  - m_Id: 22369325063524352
    m_Localized: "Escorta\u021Bi VIP-ul p\xE2n\u0103 la ie\u0219ire"
    m_Metadata:
      m_Items: []
  - m_Id: 22369412472819712
    m_Localized: "Singurul mod \xEEn care \u0219tii cum... ca prezervativ!"
    m_Metadata:
      m_Items: []
  - m_Id: 22369813393756160
    m_Localized: "Excelent agent de lucru. Ne vedem pe partea cealalt\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 22370233231003648
    m_Localized: "Dac\u0103 e\u0219ti la \xEEndem\xE2n\u0103, avem o cerere pentru
      tine."
    m_Metadata:
      m_Items: []
  - m_Id: 22370418040426496
    m_Localized: "Un VIP este \xEEntr-o celul\u0103 aproape de tine.\nAdu-le cu tine
      dac\u0103 po\u021Bi. "
    m_Metadata:
      m_Items: []
  - m_Id: 22370646848098304
    m_Localized: "De\u0219i \xEE\u021Bi va \xEEngreuna sc\u0103parea..."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
