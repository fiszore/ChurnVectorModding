  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: PrisonBreakMod_fi
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: fi
  m_SharedData: {fileID: 11400000, guid: 09105430001d7424a9c35ff9ec274c87, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 22367938804109312
    m_Localized: "Pid\xE4 matala profiili..."
    m_Metadata:
      m_Items: []
  - m_Id: 159430135808
    m_Localized: Prison Break
    m_Metadata:
      m_Items: []
  - m_Id: 253495791616
    m_Localized: Kun olet GlorpCo vanginnut, sinun on pakene!
    m_Metadata:
      m_Items: []
  - m_Id: 519808929792
    m_Localized: Breakout
    m_Metadata:
      m_Items: []
  - m_Id: 411806946742272
    m_Localized: "Agentti, kuuletko minua? Sinun t\xE4ytyy p\xE4\xE4st\xE4 pois sielt\xE4."
    m_Metadata:
      m_Items: []
  - m_Id: 412025037967360
    m_Localized: "En edes aio kysy\xE4, kuinka sait kommunikaattorisi turvallisuuden
      l\xE4pi..."
    m_Metadata:
      m_Items: []
  - m_Id: 412350331408384
    m_Localized: "Upseeri tulee kuulustelemaan sinua, se on lippusi sellist\xE4."
    m_Metadata:
      m_Items: []
  - m_Id: 412490337275904
    m_Localized: "Varoitus, turvallisuus t\xE4\xE4ll\xE4 on hieman erilainen kuin
      mihin olet tottunut."
    m_Metadata:
      m_Items: []
  - m_Id: 412565033635840
    m_Localized: "Kaikki vihre\xE4t ovet toimivat odotetulla tavalla. Napauta vain
      keskialuetta ja ne avautuvat."
    m_Metadata:
      m_Items: []
  - m_Id: 412884417302528
    m_Localized: "Sinisi\xE4 ovia sen sijaan ei voi avata normaalisti."
    m_Metadata:
      m_Items: []
  - m_Id: 412982119419904
    m_Localized: "Jos l\xF6yd\xE4t p\xE4\xE4syp\xE4\xE4tteen, sinun pit\xE4isi pysty\xE4
      saamaan n\xE4m\xE4 ovet auki."
    m_Metadata:
      m_Items: []
  - m_Id: 413095067832320
    m_Localized: "Vartija l\xE4hestyy, olet yl\xF6s.\nOnnea agentti."
    m_Metadata:
      m_Items: []
  - m_Id: 22367388935049216
    m_Localized: Paeta!
    m_Metadata:
      m_Items: []
  - m_Id: 22367773938601984
    m_Localized: Etsi tapa paeta laitoksesta
    m_Metadata:
      m_Items: []
  - m_Id: 22368139904208896
    m_Localized: Pakene varoittamatta turvallisuutta
    m_Metadata:
      m_Items: []
  - m_Id: 22368273358573568
    m_Localized: Vartijan CV
    m_Metadata:
      m_Items: []
  - m_Id: 22369034335342592
    m_Localized: Aiheuttaa kaaosta!
    m_Metadata:
      m_Items: []
  - m_Id: 22369325063524352
    m_Localized: "Saata VIP ulosk\xE4yntiin"
    m_Metadata:
      m_Items: []
  - m_Id: 22369412472819712
    m_Localized: Ainoa tapa, jolla osaat... kondomina!
    m_Metadata:
      m_Items: []
  - m_Id: 22369813393756160
    m_Localized: "Erinomainen ty\xF6agentti. N\xE4hd\xE4\xE4n toisella puolella."
    m_Metadata:
      m_Items: []
  - m_Id: 22370233231003648
    m_Localized: "Jos olet valmis, meill\xE4 on sinulle pyynt\xF6."
    m_Metadata:
      m_Items: []
  - m_Id: 22370418040426496
    m_Localized: "VIP on l\xE4hell\xE4si olevassa selliss\xE4.\nOta ne mukaasi, jos
      voit. "
    m_Metadata:
      m_Items: []
  - m_Id: 22370646848098304
    m_Localized: Vaikka se tekee pakostasi vaikean...
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
