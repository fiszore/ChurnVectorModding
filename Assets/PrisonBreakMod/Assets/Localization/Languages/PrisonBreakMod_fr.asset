  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: PrisonBreakMod_fr
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 09105430001d7424a9c35ff9ec274c87, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 159430135808
    m_Localized: "\xC9vasion de prison"
    m_Metadata:
      m_Items: []
  - m_Id: 253495791616
    m_Localized: "Apr\xE8s avoir \xE9t\xE9 captur\xE9 par GlorpCo, vous devez vous
      \xE9chapper !"
    m_Metadata:
      m_Items: []
  - m_Id: 519808929792
    m_Localized: "\xC9clater"
    m_Metadata:
      m_Items: []
  - m_Id: 411806946742272
    m_Localized: "Agent, vous m'entendez ? Vous devez sortir de l\xE0."
    m_Metadata:
      m_Items: []
  - m_Id: 412025037967360
    m_Localized: "Je ne vais m\xEAme pas vous demander comment vous avez fait passer
      votre communicateur \xE0 travers la s\xE9curit\xE9..."
    m_Metadata:
      m_Items: []
  - m_Id: 412350331408384
    m_Localized: Un officier vient vous interroger, ce sera votre ticket de sortie
      de cellule.
    m_Metadata:
      m_Items: []
  - m_Id: 412490337275904
    m_Localized: "Soyez pr\xE9venu, la s\xE9curit\xE9 ici est un peu diff\xE9rente
      de celle \xE0 laquelle vous \xEAtes habitu\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 412565033635840
    m_Localized: "Toutes les portes vertes fonctionnent comme pr\xE9vu, appuyez simplement
      sur la zone centrale et elles s'ouvriront."
    m_Metadata:
      m_Items: []
  - m_Id: 412884417302528
    m_Localized: "Les portes bleues, en revanche, ne peuvent pas \xEAtre ouvertes
      normalement."
    m_Metadata:
      m_Items: []
  - m_Id: 412982119419904
    m_Localized: "Si vous pouvez trouver un terminal d'acc\xE8s, vous devriez pouvoir
      ouvrir ces portes."
    m_Metadata:
      m_Items: []
  - m_Id: 413095067832320
    m_Localized: "Le garde approche, \xE0 vous de jouer.\nBonne chance, agent."
    m_Metadata:
      m_Items: []
  - m_Id: 22367388935049216
    m_Localized: "S'\xE9chapper!"
    m_Metadata:
      m_Items: []
  - m_Id: 22367773938601984
    m_Localized: "Trouvez un moyen de vous \xE9chapper de l'\xE9tablissement"
    m_Metadata:
      m_Items: []
  - m_Id: 22367938804109312
    m_Localized: Gardez un faible profit...
    m_Metadata:
      m_Items: []
  - m_Id: 22368139904208896
    m_Localized: "S'\xE9chapper sans alerter la s\xE9curit\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 22368273358573568
    m_Localized: CV le gardien
    m_Metadata:
      m_Items: []
  - m_Id: 22369034335342592
    m_Localized: Provoquez le chaos !
    m_Metadata:
      m_Items: []
  - m_Id: 22369325063524352
    m_Localized: "Escorter le VIP jusqu'\xE0 la sortie"
    m_Metadata:
      m_Items: []
  - m_Id: 22369412472819712
    m_Localized: "La seule fa\xE7on que vous connaissez... comme un pr\xE9servatif
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 22369813393756160
    m_Localized: "Excellent travail, agent. \xC0 bient\xF4t de l'autre c\xF4t\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 22370233231003648
    m_Localized: Si vous le souhaitez, nous avons une demande pour vous.
    m_Metadata:
      m_Items: []
  - m_Id: 22370418040426496
    m_Localized: "Un VIP se trouve dans une cellule pr\xE8s de chez vous. Emmenez-le
      avec vous si possible."
    m_Metadata:
      m_Items: []
  - m_Id: 22370646848098304
    m_Localized: "M\xEAme si cela rendra votre \xE9vasion difficile..."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
