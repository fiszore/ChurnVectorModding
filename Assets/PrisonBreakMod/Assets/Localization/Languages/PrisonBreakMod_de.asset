  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: PrisonBreakMod_de
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: 09105430001d7424a9c35ff9ec274c87, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 159430135808
    m_Localized: "Gef\xE4ngnisausbruch"
    m_Metadata:
      m_Items: []
  - m_Id: 253495791616
    m_Localized: "Nachdem Sie von GlorpCo gefangen genommen wurden, m\xFCssen Sie
      fliehen!"
    m_Metadata:
      m_Items: []
  - m_Id: 519808929792
    m_Localized: Ausbruch
    m_Metadata:
      m_Items: []
  - m_Id: 411806946742272
    m_Localized: "Agent, k\xF6nnen Sie mich h\xF6ren? Sie m\xFCssen da raus."
    m_Metadata:
      m_Items: []
  - m_Id: 412025037967360
    m_Localized: "Ich werde nicht einmal fragen, wie Sie Ihren Kommunikator durch
      die Sicherheitskontrolle bekommen haben \u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 412350331408384
    m_Localized: "Ein Beamter wird Sie verh\xF6ren. Das ist Ihre Fahrkarte aus der
      Zelle."
    m_Metadata:
      m_Items: []
  - m_Id: 412490337275904
    m_Localized: Seien Sie gewarnt, die Sicherheit hier ist etwas anders, als Sie
      es gewohnt sind.
    m_Metadata:
      m_Items: []
  - m_Id: 412565033635840
    m_Localized: "Alle gr\xFCnen T\xFCren funktionieren wie erwartet. Tippen Sie
      einfach auf den mittleren Bereich und sie \xF6ffnen sich."
    m_Metadata:
      m_Items: []
  - m_Id: 412884417302528
    m_Localized: "Blaue T\xFCren hingegen lassen sich nicht normal \xF6ffnen."
    m_Metadata:
      m_Items: []
  - m_Id: 412982119419904
    m_Localized: "Wenn Sie ein Zugangsterminal finden, sollten Sie diese T\xFCren
      \xF6ffnen k\xF6nnen."
    m_Metadata:
      m_Items: []
  - m_Id: 413095067832320
    m_Localized: "Der Wachmann n\xE4hert sich, Sie sind dran.\nViel Gl\xFCck, Agent."
    m_Metadata:
      m_Items: []
  - m_Id: 22367388935049216
    m_Localized: Flucht!
    m_Metadata:
      m_Items: []
  - m_Id: 22367773938601984
    m_Localized: Finden Sie einen Weg, aus der Einrichtung zu entkommen
    m_Metadata:
      m_Items: []
  - m_Id: 22367938804109312
    m_Localized: "Bleiben Sie unauff\xE4llig ..."
    m_Metadata:
      m_Items: []
  - m_Id: 22368139904208896
    m_Localized: Entkommen, ohne den Sicherheitsdienst zu alarmieren
    m_Metadata:
      m_Items: []
  - m_Id: 22368273358573568
    m_Localized: "Lebenslauf des W\xE4chters"
    m_Metadata:
      m_Items: []
  - m_Id: 22369034335342592
    m_Localized: Verursachen Sie Chaos!
    m_Metadata:
      m_Items: []
  - m_Id: 22369325063524352
    m_Localized: Begleiten Sie den VIP zum Ausgang
    m_Metadata:
      m_Items: []
  - m_Id: 22369412472819712
    m_Localized: Der einzige Weg, den Sie kennen ... als Kondom!
    m_Metadata:
      m_Items: []
  - m_Id: 22369813393756160
    m_Localized: Ausgezeichnete Arbeit, Agent. Wir sehen uns auf der anderen Seite.
    m_Metadata:
      m_Items: []
  - m_Id: 22370233231003648
    m_Localized: Wenn Sie Lust haben, haben wir eine Bitte an Sie.
    m_Metadata:
      m_Items: []
  - m_Id: 22370418040426496
    m_Localized: "Ein VIP befindet sich in einer Zelle in Ihrer N\xE4he.\nBringen
      Sie ihn nach M\xF6glichkeit mit."
    m_Metadata:
      m_Items: []
  - m_Id: 22370646848098304
    m_Localized: "Obwohl es Ihre Flucht erschweren wird \u2026"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
