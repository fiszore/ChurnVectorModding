  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: PrisonBreakMod_cs
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: cs
  m_SharedData: {fileID: 11400000, guid: 09105430001d7424a9c35ff9ec274c87, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 159430135808
    m_Localized: "\xDAt\u011Bk z v\u011Bzen\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 253495791616
    m_Localized: "Pot\xE9, co v\xE1s zajme GlorpCo, mus\xEDte ut\xE9ct!"
    m_Metadata:
      m_Items: []
  - m_Id: 519808929792
    m_Localized: Breakout
    m_Metadata:
      m_Items: []
  - m_Id: 411806946742272
    m_Localized: "Agentko, sly\u0161\xEDte m\u011B? Mus\xED\u0161 se odtamtud dostat."
    m_Metadata:
      m_Items: []
  - m_Id: 412025037967360
    m_Localized: "Ani se nebudu pt\xE1t, jak jsi dostal sv\u016Fj komunik\xE1tor
      p\u0159es bezpe\u010Dnost..."
    m_Metadata:
      m_Items: []
  - m_Id: 412350331408384
    m_Localized: "D\u016Fstojn\xEDk v\xE1s p\u0159ijde vyslechnout, to bude va\u0161e
      vstupenka z cely."
    m_Metadata:
      m_Items: []
  - m_Id: 412490337275904
    m_Localized: "Pozor, zabezpe\u010Den\xED je zde trochu jin\xE9, ne\u017E jste
      zvykl\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 412565033635840
    m_Localized: "Jak\xE9koli zelen\xE9 dve\u0159e funguj\xED tak, jak byste o\u010Dek\xE1vali,
      jednodu\u0161e klepn\u011Bte na centr\xE1ln\xED oblast a otev\u0159ou se."
    m_Metadata:
      m_Items: []
  - m_Id: 412884417302528
    m_Localized: "Modr\xE9 dve\u0159e na druh\xE9 stran\u011B nelze norm\xE1ln\u011B
      otev\u0159\xEDt."
    m_Metadata:
      m_Items: []
  - m_Id: 412982119419904
    m_Localized: "Pokud najdete p\u0159\xEDstupov\xFD termin\xE1l, m\u011Bli byste
      b\xFDt schopni tyto dve\u0159e otev\u0159\xEDt."
    m_Metadata:
      m_Items: []
  - m_Id: 413095067832320
    m_Localized: "Hl\xEDda\u010D se bl\xED\u017E\xED, jste vzh\u016Fru.\nHodn\u011B
      \u0161t\u011Bst\xED agente."
    m_Metadata:
      m_Items: []
  - m_Id: 22367388935049216
    m_Localized: Uniknout!
    m_Metadata:
      m_Items: []
  - m_Id: 22367773938601984
    m_Localized: "Najd\u011Bte zp\u016Fsob, jak uniknout ze za\u0159\xEDzen\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 22367938804109312
    m_Localized: "Udr\u017Eujte n\xEDzk\xFD profil..."
    m_Metadata:
      m_Items: []
  - m_Id: 22368139904208896
    m_Localized: "Ute\u010Dte bez varov\xE1n\xED bezpe\u010Dnosti"
    m_Metadata:
      m_Items: []
  - m_Id: 22368273358573568
    m_Localized: "CV spr\xE1vce"
    m_Metadata:
      m_Items: []
  - m_Id: 22369034335342592
    m_Localized: "Zp\u016Fsobit chaos!"
    m_Metadata:
      m_Items: []
  - m_Id: 22369325063524352
    m_Localized: "Doprovod VIP k v\xFDchodu"
    m_Metadata:
      m_Items: []
  - m_Id: 22369412472819712
    m_Localized: "Jedin\xFD zp\u016Fsob, jak v\xEDte jak... jako kondom!"
    m_Metadata:
      m_Items: []
  - m_Id: 22369813393756160
    m_Localized: "Skv\u011Bl\xFD pracovn\xED agent. Uvid\xEDme se na druh\xE9 stran\u011B."
    m_Metadata:
      m_Items: []
  - m_Id: 22370233231003648
    m_Localized: "Pokud na to m\xE1te, m\xE1me na v\xE1s prosbu."
    m_Metadata:
      m_Items: []
  - m_Id: 22370418040426496
    m_Localized: "VIP je v cele bl\xEDzko v\xE1s.\nPokud m\u016F\u017Eete, p\u0159ineste
      je s sebou. "
    m_Metadata:
      m_Items: []
  - m_Id: 22370646848098304
    m_Localized: "I kdy\u017E v\xE1m to zt\xED\u017E\xED \xFAt\u011Bk..."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
