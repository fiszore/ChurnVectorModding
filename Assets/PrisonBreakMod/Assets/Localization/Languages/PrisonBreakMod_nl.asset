  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: PrisonBreakMod_nl
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: nl
  m_SharedData: {fileID: 11400000, guid: 09105430001d7424a9c35ff9ec274c87, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 159430135808
    m_Localized: Gevangenisuitbraak
    m_Metadata:
      m_Items: []
  - m_Id: 253495791616
    m_Localized: Nadat je gevangen bent genomen door GlorpCo, moet je ontsnappen!
    m_Metadata:
      m_Items: []
  - m_Id: 519808929792
    m_Localized: Uitbraak
    m_Metadata:
      m_Items: []
  - m_Id: 411806946742272
    m_Localized: Agent, kunt u me horen? U moet daar weg.
    m_Metadata:
      m_Items: []
  - m_Id: 412025037967360
    m_Localized: Ik ga niet eens vragen hoe je je communicator door de beveiliging
      hebt gekregen...
    m_Metadata:
      m_Items: []
  - m_Id: 412350331408384
    m_Localized: Er komt een agent om je te ondervragen. Dat is je ticket om uit
      de cel te komen.
    m_Metadata:
      m_Items: []
  - m_Id: 412490337275904
    m_Localized: Wees gewaarschuwd, de beveiliging is hier iets anders dan u gewend
      bent.
    m_Metadata:
      m_Items: []
  - m_Id: 412565033635840
    m_Localized: 'Alle groene deuren werken zoals je zou verwachten: tik gewoon op
      het centrale gedeelte en ze gaan open.'
    m_Metadata:
      m_Items: []
  - m_Id: 412884417302528
    m_Localized: Blauwe deuren kunnen daarentegen niet normaal geopend worden.
    m_Metadata:
      m_Items: []
  - m_Id: 412982119419904
    m_Localized: Als u een toegangsterminal kunt vinden, zou u deze deuren moeten
      kunnen openen.
    m_Metadata:
      m_Items: []
  - m_Id: 413095067832320
    m_Localized: 'De bewaker komt eraan, jij bent aan de beurt.

      Veel succes,
      agent.'
    m_Metadata:
      m_Items: []
  - m_Id: 22367388935049216
    m_Localized: Ontsnappen!
    m_Metadata:
      m_Items: []
  - m_Id: 22367773938601984
    m_Localized: Vind een manier om uit de faciliteit te ontsnappen
    m_Metadata:
      m_Items: []
  - m_Id: 22367938804109312
    m_Localized: Houd een onopvallend profiel...
    m_Metadata:
      m_Items: []
  - m_Id: 22368139904208896
    m_Localized: Ontsnappen zonder de beveiliging te waarschuwen
    m_Metadata:
      m_Items: []
  - m_Id: 22368273358573568
    m_Localized: CV de Warden
    m_Metadata:
      m_Items: []
  - m_Id: 22369034335342592
    m_Localized: Zorg voor chaos!
    m_Metadata:
      m_Items: []
  - m_Id: 22369325063524352
    m_Localized: Begeleid de VIP naar de uitgang
    m_Metadata:
      m_Items: []
  - m_Id: 22369412472819712
    m_Localized: De enige manier die je kent... als condoom!
    m_Metadata:
      m_Items: []
  - m_Id: 22369813393756160
    m_Localized: Uitstekend werk, agent. Tot ziens aan de andere kant.
    m_Metadata:
      m_Items: []
  - m_Id: 22370233231003648
    m_Localized: Als u er zin in heeft, hebben wij een verzoek voor u.
    m_Metadata:
      m_Items: []
  - m_Id: 22370418040426496
    m_Localized: 'Er zit een VIP in een cel vlakbij je.

      Neem hem of haar mee
      als je kunt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22370646848098304
    m_Localized: Hoewel het je ontsnapping wel moeilijk zal maken...
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
