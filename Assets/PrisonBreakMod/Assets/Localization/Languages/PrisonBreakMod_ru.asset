  m_TableData:
  - m_Id: 159430135808
    m_Localized: "\u041F\u043E\u0431\u0435\u0433 \u0438\u0437 \u0442\u044E\u0440\u044C\u043C\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 253495791616
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0442\u043E\u0433\u043E, \u043A\u0430\u043A
      \u0432\u0430\u0441 \u0437\u0430\u0445\u0432\u0430\u0442\u0438\u043B\u0430 GlorpCo,
      \u0432\u0430\u043C \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F \u0441\u0431\u0435\u0436\u0430\u0442\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 519808929792
    m_Localized: "\u0420\u0430\u0437\u0440\u0430\u0437\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 411806946742272
    m_Localized: "\u0410\u0433\u0435\u043D\u0442, \u0432\u044B \u043C\u0435\u043D\u044F
      \u0441\u043B\u044B\u0448\u0438\u0442\u0435? \u0412\u0430\u043C \u043D\u0443\u0436\u043D\u043E
      \u0443\u0439\u0442\u0438 \u043E\u0442\u0442\u0443\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 412025037967360
    m_Localized: "\u042F \u0434\u0430\u0436\u0435 \u043D\u0435 \u0431\u0443\u0434\u0443
      \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0442\u044C, \u043A\u0430\u043A
      \u0432\u044B \u043F\u0440\u043E\u043D\u0435\u0441\u043B\u0438 \u0441\u0432\u043E\u0439
      \u043A\u043E\u043C\u043C\u0443\u043D\u0438\u043A\u0430\u0442\u043E\u0440 \u0447\u0435\u0440\u0435\u0437
      \u0441\u043B\u0443\u0436\u0431\u0443 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438..."
    m_Metadata:
      m_Items: []
  - m_Id: 412350331408384
    m_Localized: "\u041A \u0432\u0430\u043C \u043F\u0440\u0438\u0434\u0435\u0442
      \u043E\u0444\u0438\u0446\u0435\u0440, \u0447\u0442\u043E\u0431\u044B \u0434\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C
      \u0432\u0430\u0441. \u042D\u0442\u043E \u0431\u0443\u0434\u0435\u0442 \u0432\u0430\u0448\u0438\u043C
      \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u043E\u043C \u0438\u0437 \u043A\u0430\u043C\u0435\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 412490337275904
    m_Localized: "\u0418\u043C\u0435\u0439\u0442\u0435 \u0432 \u0432\u0438\u0434\u0443,
      \u0447\u0442\u043E \u043C\u0435\u0440\u044B \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438
      \u0437\u0434\u0435\u0441\u044C \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043E\u0442\u043B\u0438\u0447\u0430\u044E\u0442\u0441\u044F
      \u043E\u0442 \u0442\u0435\u0445, \u043A \u043A\u043E\u0442\u043E\u0440\u044B\u043C
      \u0432\u044B \u043F\u0440\u0438\u0432\u044B\u043A\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 412565033635840
    m_Localized: "\u0412\u0441\u0435 \u0437\u0435\u043B\u0435\u043D\u044B\u0435 \u0434\u0432\u0435\u0440\u0438
      \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442 \u0442\u0430\u043A, \u043A\u0430\u043A
      \u0438 \u043E\u0436\u0438\u0434\u0430\u043B\u043E\u0441\u044C: \u043F\u0440\u043E\u0441\u0442\u043E
      \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u0443\u044E
      \u043E\u0431\u043B\u0430\u0441\u0442\u044C, \u0438 \u043E\u043D\u0438 \u043E\u0442\u043A\u0440\u043E\u044E\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 412884417302528
    m_Localized: "\u0421\u0438\u043D\u0438\u0435 \u0434\u0432\u0435\u0440\u0438,
      \u0441 \u0434\u0440\u0443\u0433\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B,
      \u043D\u0435 \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C \u043E\u0442\u043A\u0440\u044B\u0442\u044B
      \u043E\u0431\u044B\u0447\u043D\u044B\u043C \u0441\u043F\u043E\u0441\u043E\u0431\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 412982119419904
    m_Localized: "\u0415\u0441\u043B\u0438 \u0432\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435
      \u043D\u0430\u0439\u0442\u0438 \u0442\u0435\u0440\u043C\u0438\u043D\u0430\u043B
      \u0434\u043E\u0441\u0442\u0443\u043F\u0430, \u0432\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435
      \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u044D\u0442\u0438 \u0434\u0432\u0435\u0440\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 413095067832320
    m_Localized: "\u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u0435\u0442\u0441\u044F,
      \u0432\u044B \u043D\u0430\u0432\u0435\u0440\u0445\u0443. \u0423\u0434\u0430\u0447\u0438,
      \u0430\u0433\u0435\u043D\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 22367388935049216
    m_Localized: "\u041F\u043E\u0431\u0435\u0433!"
    m_Metadata:
      m_Items: []
  - m_Id: 22367773938601984
    m_Localized: "\u041D\u0430\u0439\u0434\u0438\u0442\u0435 \u0441\u043F\u043E\u0441\u043E\u0431
      \u0441\u0431\u0435\u0436\u0430\u0442\u044C \u0438\u0437 \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 22367938804109312
    m_Localized: "\u0421\u043E\u0445\u0440\u0430\u043D\u044F\u0439\u0442\u0435 \u043D\u0438\u0437\u043A\u0438\u0439
      \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u043F\u0440\u043E\u0444\u0435..."
    m_Metadata:
      m_Items: []
  - m_Id: 22368139904208896
    m_Localized: "\u041F\u043E\u0431\u0435\u0433 \u0431\u0435\u0437 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F
      \u043E\u0445\u0440\u0430\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 22368273358573568
    m_Localized: "\u0420\u0435\u0437\u044E\u043C\u0435 \u043D\u0430\u0434\u0437\u0438\u0440\u0430\u0442\u0435\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 22369034335342592
    m_Localized: "\u0423\u0441\u0442\u0440\u043E\u0439\u0442\u0435 \u0445\u0430\u043E\u0441!"
    m_Metadata:
      m_Items: []
  - m_Id: 22369325063524352
    m_Localized: "\u0421\u043E\u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u044C
      VIP-\u043F\u0435\u0440\u0441\u043E\u043D\u0443 \u043A \u0432\u044B\u0445\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 22369412472819712
    m_Localized: "\u0415\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
      \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439 \u0432\u0430\u043C \u0441\u043F\u043E\u0441\u043E\u0431...
      \u043F\u0440\u0435\u0437\u0435\u0440\u0432\u0430\u0442\u0438\u0432!"
    m_Metadata:
      m_Items: []
  - m_Id: 22369813393756160
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430,
      \u0430\u0433\u0435\u043D\u0442. \u0423\u0432\u0438\u0434\u0438\u043C\u0441\u044F
      \u043F\u043E \u0442\u0443 \u0441\u0442\u043E\u0440\u043E\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 22370233231003648
    m_Localized: "\u0415\u0441\u043B\u0438 \u0432\u044B \u0433\u043E\u0442\u043E\u0432\u044B,
      \u0443 \u043D\u0430\u0441 \u0435\u0441\u0442\u044C \u043A \u0432\u0430\u043C
      \u043F\u0440\u043E\u0441\u044C\u0431\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 22370418040426496
    m_Localized: "VIP-\u043F\u0435\u0440\u0441\u043E\u043D\u044B \u043D\u0430\u0445\u043E\u0434\u044F\u0442\u0441\u044F
      \u0432 \u043A\u0430\u043C\u0435\u0440\u0435 \u0440\u044F\u0434\u043E\u043C
      \u0441 \u0432\u0430\u043C\u0438.\n\u0412\u043E\u0437\u044C\u043C\u0438\u0442\u0435
      \u0438\u0445 \u0441 \u0441\u043E\u0431\u043E\u0439, \u0435\u0441\u043B\u0438
      \u043C\u043E\u0436\u0435\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 22370646848098304
    m_Localized: "\u0425\u043E\u0442\u044F \u044D\u0442\u043E \u0437\u0430\u0442\u0440\u0443\u0434\u043D\u0438\u0442
      \u0432\u0430\u0448 \u043F\u043E\u0431\u0435\u0433..."
    m_Metadata:
      m_Items: []
