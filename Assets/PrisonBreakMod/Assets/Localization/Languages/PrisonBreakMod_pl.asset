  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: PrisonBreakMod_pl
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: pl
  m_SharedData: {fileID: 11400000, guid: 09105430001d7424a9c35ff9ec274c87, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 159430135808
    m_Localized: "Ucieczka z wi\u0119zienia"
    m_Metadata:
      m_Items: []
  - m_Id: 253495791616
    m_Localized: Po tym, jak zostaniesz schwytany przez GlorpCo, musisz uciec!
    m_Metadata:
      m_Items: []
  - m_Id: 519808929792
    m_Localized: "Wyj\u015Bcie"
    m_Metadata:
      m_Items: []
  - m_Id: 411806946742272
    m_Localized: "Agencie, s\u0142yszysz mnie? Musisz si\u0119 stamt\u0105d wydosta\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 412025037967360
    m_Localized: "Nawet nie b\u0119d\u0119 pyta\u0107, jak uda\u0142o Ci si\u0119
      przechwyci\u0107 komunikator przez zabezpieczenia..."
    m_Metadata:
      m_Items: []
  - m_Id: 412350331408384
    m_Localized: "Przyjdzie do ciebie oficer, \u017Ceby ci\u0119 przes\u0142ucha\u0107,
      to b\u0119dzie tw\xF3j bilet wyj\u015Bcia z celi."
    m_Metadata:
      m_Items: []
  - m_Id: 412490337275904
    m_Localized: "Uwa\u017Caj, bo zabezpieczenia tutaj s\u0105 troch\u0119 inne,
      ni\u017C te, do kt\xF3rych jeste\u015B przyzwyczajony."
    m_Metadata:
      m_Items: []
  - m_Id: 412565033635840
    m_Localized: "Wszystkie zielone drzwi dzia\u0142aj\u0105 tak, jak mo\u017Cna
      si\u0119 spodziewa\u0107 \u2013 wystarczy dotkn\u0105\u0107 ich \u015Brodkowej
      cz\u0119\u015Bci, a si\u0119 otworz\u0105."
    m_Metadata:
      m_Items: []
  - m_Id: 412884417302528
    m_Localized: "Natomiast niebieskich drzwi nie da si\u0119 normalnie otworzy\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 412982119419904
    m_Localized: "Je\u017Celi uda ci si\u0119 znale\u017A\u0107 terminal dost\u0119powy,
      powiniene\u015B m\xF3c otworzy\u0107 te drzwi."
    m_Metadata:
      m_Items: []
  - m_Id: 413095067832320
    m_Localized: "Stra\u017Cnik si\u0119 zbli\u017Ca, ty wstajesz.\nPowodzenia agencie."
    m_Metadata:
      m_Items: []
  - m_Id: 22367388935049216
    m_Localized: Ucieczka!
    m_Metadata:
      m_Items: []
  - m_Id: 22367773938601984
    m_Localized: "Znajd\u017A spos\xF3b na ucieczk\u0119 z o\u015Brodka"
    m_Metadata:
      m_Items: []
  - m_Id: 22367938804109312
    m_Localized: Zachowaj niski profil...
    m_Metadata:
      m_Items: []
  - m_Id: 22368139904208896
    m_Localized: Ucieknij bez powiadamiania ochrony
    m_Metadata:
      m_Items: []
  - m_Id: 22368273358573568
    m_Localized: "CV Stra\u017Cnika"
    m_Metadata:
      m_Items: []
  - m_Id: 22369034335342592
    m_Localized: "Zr\xF3b troch\u0119 zamieszania!"
    m_Metadata:
      m_Items: []
  - m_Id: 22369325063524352
    m_Localized: "Odprowad\u017A VIP-a do wyj\u015Bcia"
    m_Metadata:
      m_Items: []
  - m_Id: 22369412472819712
    m_Localized: "Jedyny spos\xF3b, jaki znasz... jako prezerwatyw\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 22369813393756160
    m_Localized: "\u015Awietna robota, agencie. Do zobaczenia po drugiej stronie."
    m_Metadata:
      m_Items: []
  - m_Id: 22370233231003648
    m_Localized: "Je\u017Celi jeste\u015B na to gotowy, mamy dla Ciebie pro\u015Bb\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 22370418040426496
    m_Localized: "VIP jest w celi blisko ciebie.\nZabierz ich ze sob\u0105, je\u015Bli
      mo\u017Cesz."
    m_Metadata:
      m_Items: []
  - m_Id: 22370646848098304
    m_Localized: "Cho\u0107 to utrudni ucieczk\u0119..."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
