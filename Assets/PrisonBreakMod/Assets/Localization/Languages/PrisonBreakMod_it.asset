  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: PrisonBreakMod_it
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: it
  m_SharedData: {fileID: 11400000, guid: 09105430001d7424a9c35ff9ec274c87, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 159430135808
    m_Localized: Evasione
    m_Metadata:
      m_Items: []
  - m_Id: 253495791616
    m_Localized: Dopo essere stato catturato dalla GlorpCo, devi scappare!
    m_Metadata:
      m_Items: []
  - m_Id: 519808929792
    m_Localized: Scoppiare
    m_Metadata:
      m_Items: []
  - m_Id: 411806946742272
    m_Localized: "Agente, mi sente? Deve andarsene da l\xEC."
    m_Metadata:
      m_Items: []
  - m_Id: 412025037967360
    m_Localized: Non ho nemmeno intenzione di chiederti come hai fatto a far passare
      il tuo comunicatore attraverso i controlli di sicurezza...
    m_Metadata:
      m_Items: []
  - m_Id: 412350331408384
    m_Localized: "Un agente verr\xE0 a interrogarti: sar\xE0 il tuo biglietto per
      uscire dalla cella."
    m_Metadata:
      m_Items: []
  - m_Id: 412490337275904
    m_Localized: Attenzione, le misure di sicurezza qui sono un po' diverse da quelle
      a cui siete abituati.
    m_Metadata:
      m_Items: []
  - m_Id: 412565033635840
    m_Localized: 'Tutte le porte verdi funzionano come previsto: basta toccare la
      zona centrale e si apriranno.'
    m_Metadata:
      m_Items: []
  - m_Id: 412884417302528
    m_Localized: Le porte blu, invece, non possono essere aperte normalmente.
    m_Metadata:
      m_Items: []
  - m_Id: 412982119419904
    m_Localized: Se riesci a trovare un terminale di accesso, dovresti riuscire ad
      aprire queste porte.
    m_Metadata:
      m_Items: []
  - m_Id: 413095067832320
    m_Localized: 'La guardia si sta avvicinando, sei pronto.

      Buona fortuna,
      agente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22367388935049216
    m_Localized: Fuga!
    m_Metadata:
      m_Items: []
  - m_Id: 22367773938601984
    m_Localized: Trova un modo per fuggire dalla struttura
    m_Metadata:
      m_Items: []
  - m_Id: 22367938804109312
    m_Localized: Mantieni un basso profilo...
    m_Metadata:
      m_Items: []
  - m_Id: 22368139904208896
    m_Localized: Fuggire senza allertare la sicurezza
    m_Metadata:
      m_Items: []
  - m_Id: 22368273358573568
    m_Localized: CV il Guardiano
    m_Metadata:
      m_Items: []
  - m_Id: 22369034335342592
    m_Localized: Crea un po' di caos!
    m_Metadata:
      m_Items: []
  - m_Id: 22369325063524352
    m_Localized: Accompagnare il VIP all'uscita
    m_Metadata:
      m_Items: []
  - m_Id: 22369412472819712
    m_Localized: L'unico modo che conosci... come un preservativo!
    m_Metadata:
      m_Items: []
  - m_Id: 22369813393756160
    m_Localized: Ottimo lavoro, agente. Ci vediamo dall'altra parte.
    m_Metadata:
      m_Items: []
  - m_Id: 22370233231003648
    m_Localized: Se ne hai voglia, abbiamo una richiesta per te.
    m_Metadata:
      m_Items: []
  - m_Id: 22370418040426496
    m_Localized: "Un VIP \xE8 in una cella vicino alla tua. Portalo con te se puoi."
    m_Metadata:
      m_Items: []
  - m_Id: 22370646848098304
    m_Localized: "Anche se render\xE0 difficile la tua fuga..."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
