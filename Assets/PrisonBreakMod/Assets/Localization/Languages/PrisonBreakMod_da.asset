  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: PrisonBreakMod_da
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: da
  m_SharedData: {fileID: 11400000, guid: 09105430001d7424a9c35ff9ec274c87, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 159430135808
    m_Localized: Prison Break
    m_Metadata:
      m_Items: []
  - m_Id: 253495791616
    m_Localized: "Efter at v\xE6re blevet fanget af GlorpCo, skal du undslippe!"
    m_Metadata:
      m_Items: []
  - m_Id: 519808929792
    m_Localized: Udbrud
    m_Metadata:
      m_Items: []
  - m_Id: 411806946742272
    m_Localized: "Agent, kan du h\xF8re mig? Du skal ud derfra."
    m_Metadata:
      m_Items: []
  - m_Id: 412025037967360
    m_Localized: "Jeg vil ikke engang sp\xF8rge, hvordan du fik din kommunikat\xF8r
      gennem sikkerhed..."
    m_Metadata:
      m_Items: []
  - m_Id: 412350331408384
    m_Localized: "En betjent kommer for at forh\xF8re dig, det vil v\xE6re din billet
      ud af cellen."
    m_Metadata:
      m_Items: []
  - m_Id: 412490337275904
    m_Localized: "V\xE6r advaret, sikkerheden her er en smule anderledes, end du
      er vant til."
    m_Metadata:
      m_Items: []
  - m_Id: 412565033635840
    m_Localized: "Alle gr\xF8nne d\xF8re fungerer, som du ville forvente, tryk blot
      p\xE5 det centrale omr\xE5de, og de \xE5bnes."
    m_Metadata:
      m_Items: []
  - m_Id: 412884417302528
    m_Localized: "Bl\xE5 d\xF8re kan derimod ikke \xE5bnes normalt."
    m_Metadata:
      m_Items: []
  - m_Id: 412982119419904
    m_Localized: "Hvis du kan finde en adgangsterminal, b\xF8r du kunne f\xE5 disse
      d\xF8re \xE5bne."
    m_Metadata:
      m_Items: []
  - m_Id: 413095067832320
    m_Localized: "Vagten n\xE6rmer sig, du er oppe.\nHeld og lykke agent."
    m_Metadata:
      m_Items: []
  - m_Id: 22367388935049216
    m_Localized: Flugt!
    m_Metadata:
      m_Items: []
  - m_Id: 22367773938601984
    m_Localized: "Find en m\xE5de at undslippe anl\xE6gget"
    m_Metadata:
      m_Items: []
  - m_Id: 22367938804109312
    m_Localized: Hold en lav profil...
    m_Metadata:
      m_Items: []
  - m_Id: 22368139904208896
    m_Localized: Undslippe uden at advare sikkerheden
    m_Metadata:
      m_Items: []
  - m_Id: 22368273358573568
    m_Localized: CV vagten
    m_Metadata:
      m_Items: []
  - m_Id: 22369034335342592
    m_Localized: Skabe noget kaos!
    m_Metadata:
      m_Items: []
  - m_Id: 22369325063524352
    m_Localized: Eskorter VIP'en til udgangen
    m_Metadata:
      m_Items: []
  - m_Id: 22369412472819712
    m_Localized: "Den eneste m\xE5de du ved hvordan... som et kondom!"
    m_Metadata:
      m_Items: []
  - m_Id: 22369813393756160
    m_Localized: "Fremragende arbejdsagent. Vi ses p\xE5 den anden side."
    m_Metadata:
      m_Items: []
  - m_Id: 22370233231003648
    m_Localized: Hvis du er til det, har vi en anmodning til dig.
    m_Metadata:
      m_Items: []
  - m_Id: 22370418040426496
    m_Localized: "En VIP er i en celle t\xE6t p\xE5 dig.\nTag dem med, hvis du kan. "
    m_Metadata:
      m_Items: []
  - m_Id: 22370646848098304
    m_Localized: "Selvom det vil g\xF8re din flugt sv\xE6r..."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
