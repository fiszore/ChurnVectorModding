  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: PrisonBreakMod_no
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: no
  m_SharedData: {fileID: 11400000, guid: 09105430001d7424a9c35ff9ec274c87, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 159430135808
    m_Localized: Prison Break
    m_Metadata:
      m_Items: []
  - m_Id: 253495791616
    m_Localized: "Etter \xE5 ha blitt tatt til fange av GlorpCo, m\xE5 du komme deg
      unna!"
    m_Metadata:
      m_Items: []
  - m_Id: 519808929792
    m_Localized: Utbrudd
    m_Metadata:
      m_Items: []
  - m_Id: 411806946742272
    m_Localized: "Agent, kan du h\xF8re meg? Du m\xE5 ut derfra."
    m_Metadata:
      m_Items: []
  - m_Id: 412025037967360
    m_Localized: "Jeg skal ikke engang sp\xF8rre hvordan du fikk kommunikatoren din
      gjennom sikkerhet..."
    m_Metadata:
      m_Items: []
  - m_Id: 412350331408384
    m_Localized: "En offiser kommer for \xE5 avh\xF8re deg, det vil v\xE6re billetten
      din ut av cellen."
    m_Metadata:
      m_Items: []
  - m_Id: 412490337275904
    m_Localized: "V\xE6r advart, sikkerheten her er litt annerledes enn du er vant
      til."
    m_Metadata:
      m_Items: []
  - m_Id: 412565033635840
    m_Localized: "Alle gr\xF8nne d\xF8rer fungerer som du forventer, bare trykk p\xE5
      det sentrale omr\xE5det og de \xE5pnes."
    m_Metadata:
      m_Items: []
  - m_Id: 412884417302528
    m_Localized: "Bl\xE5 d\xF8rer kan derimot ikke \xE5pnes normalt."
    m_Metadata:
      m_Items: []
  - m_Id: 412982119419904
    m_Localized: "Hvis du finner en tilgangsterminal, b\xF8r du kunne \xE5pne disse
      d\xF8rene."
    m_Metadata:
      m_Items: []
  - m_Id: 413095067832320
    m_Localized: "Vakten n\xE6rmer seg, du er oppe.\nLykke til agent."
    m_Metadata:
      m_Items: []
  - m_Id: 22367388935049216
    m_Localized: Flykte!
    m_Metadata:
      m_Items: []
  - m_Id: 22367773938601984
    m_Localized: "Finn en m\xE5te \xE5 unnslippe anlegget"
    m_Metadata:
      m_Items: []
  - m_Id: 22367938804109312
    m_Localized: Hold en lav profil...
    m_Metadata:
      m_Items: []
  - m_Id: 22368139904208896
    m_Localized: "R\xF8m uten \xE5 varsle sikkerheten"
    m_Metadata:
      m_Items: []
  - m_Id: 22368273358573568
    m_Localized: CV vaktmesteren
    m_Metadata:
      m_Items: []
  - m_Id: 22369034335342592
    m_Localized: Skap litt kaos!
    m_Metadata:
      m_Items: []
  - m_Id: 22369325063524352
    m_Localized: Eskorter VIP-en til utgangen
    m_Metadata:
      m_Items: []
  - m_Id: 22369412472819712
    m_Localized: "Den eneste m\xE5ten du vet hvordan... som kondom!"
    m_Metadata:
      m_Items: []
  - m_Id: 22369813393756160
    m_Localized: "Utmerket arbeidsagent. Vi sees p\xE5 den andre siden."
    m_Metadata:
      m_Items: []
  - m_Id: 22370233231003648
    m_Localized: "Hvis du klarer det, har vi en foresp\xF8rsel til deg."
    m_Metadata:
      m_Items: []
  - m_Id: 22370418040426496
    m_Localized: "En VIP er i en celle n\xE6r deg.\nTa dem med deg hvis du kan. "
    m_Metadata:
      m_Items: []
  - m_Id: 22370646848098304
    m_Localized: "Selv om det vil gj\xF8re flukten din vanskelig..."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
