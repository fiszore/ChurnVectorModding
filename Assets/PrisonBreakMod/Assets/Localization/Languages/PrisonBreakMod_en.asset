  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: PrisonBreakMod_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 09105430001d7424a9c35ff9ec274c87, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 159430135808
    m_Localized: Prison Break
    m_Metadata:
      m_Items:
      - rid: 5493608294520193052
  - m_Id: 253495791616
    m_Localized: After being captured by GlorpCo, you must make your escape!
    m_Metadata:
      m_Items:
      - rid: 5493608294520193053
  - m_Id: 519808929792
    m_Localized: Breakout
    m_Metadata:
      m_Items:
      - rid: 5493608294520193054
  - m_Id: 411806946742272
    m_Localized: Agent, can you hear me? You need to get out of there.
    m_Metadata:
      m_Items:
      - rid: 5493608294520193055
  - m_Id: 412025037967360
    m_Localized: I'm not even going to ask how you got your communicator through
      security...
    m_Metadata:
      m_Items:
      - rid: 5493608294520193056
  - m_Id: 412350331408384
    m_Localized: An officer is coming to interrogate you, that will be your ticket
      out of the cell.
    m_Metadata:
      m_Items:
      - rid: 5493608294520193057
  - m_Id: 412490337275904
    m_Localized: Be warned, the security here is a bit different than you are used
      to.
    m_Metadata:
      m_Items:
      - rid: 5493608294520193058
  - m_Id: 412565033635840
    m_Localized: Any green doors work as you would expect, simply tap the central
      area and they will open.
    m_Metadata:
      m_Items:
      - rid: 5493608294520193059
  - m_Id: 412884417302528
    m_Localized: Blue doors on the other hand, can not be opened normally.
    m_Metadata:
      m_Items:
      - rid: 5493608294520193060
  - m_Id: 412982119419904
    m_Localized: If you can find an access terminal, you should be able to get these
      doors open.
    m_Metadata:
      m_Items:
      - rid: 5493608294520193061
  - m_Id: 413095067832320
    m_Localized: 'The guard is approaching, you''re up.

      Good luck agent.'
    m_Metadata:
      m_Items:
      - rid: 5493608294520193062
  - m_Id: 22367388935049216
    m_Localized: Escape!
    m_Metadata:
      m_Items:
      - rid: 5493608294520193063
  - m_Id: 22367773938601984
    m_Localized: Find a way to escape the facility
    m_Metadata:
      m_Items:
      - rid: 5493608294520193064
  - m_Id: 22367938804109312
    m_Localized: Keep a low profie...
    m_Metadata:
      m_Items:
      - rid: 5493608294520193065
  - m_Id: 22368139904208896
    m_Localized: Escape without alerting security
    m_Metadata:
      m_Items:
      - rid: 5493608294520193066
  - m_Id: 22368273358573568
    m_Localized: CV the Warden
    m_Metadata:
      m_Items:
      - rid: 5493608294520193067
  - m_Id: 22369034335342592
    m_Localized: Cause some chaos!
    m_Metadata:
      m_Items:
      - rid: 5493608294520193068
  - m_Id: 22369325063524352
    m_Localized: Escort the VIP to the exit
    m_Metadata:
      m_Items:
      - rid: 5493608294520193069
  - m_Id: 22369412472819712
    m_Localized: The only way you know how... as a condom!
    m_Metadata:
      m_Items:
      - rid: 5493608294520193070
  - m_Id: 22369813393756160
    m_Localized: Excellent work agent. See you on the other side.
    m_Metadata:
      m_Items:
      - rid: 5493608294520193071
  - m_Id: 22370233231003648
    m_Localized: If you are up to it, we have a request for you.
    m_Metadata:
      m_Items:
      - rid: 5493608294520193072
  - m_Id: 22370418040426496
    m_Localized: 'A VIP is in a cell close to you.

      Bring them with you if
      you can. '
    m_Metadata:
      m_Items:
      - rid: 5493608294520193073
  - m_Id: 22370646848098304
    m_Localized: Though it will make your escape difficult...
    m_Metadata:
      m_Items:
      - rid: 5493608294520193074
