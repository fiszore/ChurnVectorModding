  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: PrisonBreakMod_es
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 09105430001d7424a9c35ff9ec274c87, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 159430135808
    m_Localized: "Fuga de la prisi\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 253495791616
    m_Localized: "\xA1Despu\xE9s de ser capturado por GlorpCo, debes escapar!"
    m_Metadata:
      m_Items: []
  - m_Id: 519808929792
    m_Localized: Fugarse
    m_Metadata:
      m_Items: []
  - m_Id: 411806946742272
    m_Localized: "Agente, \xBFme oye? Tiene que salir de ah\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 412025037967360
    m_Localized: "Ni siquiera voy a preguntar c\xF3mo lograste pasar tu comunicador
      por seguridad..."
    m_Metadata:
      m_Items: []
  - m_Id: 412350331408384
    m_Localized: "Un oficial vendr\xE1 a interrogarte, ese ser\xE1 tu boleto de salida
      de la celda."
    m_Metadata:
      m_Items: []
  - m_Id: 412490337275904
    m_Localized: "Tenga cuidado, la seguridad aqu\xED es un poco diferente a la que
      est\xE1 acostumbrado."
    m_Metadata:
      m_Items: []
  - m_Id: 412565033635840
    m_Localized: "Cualquier puerta verde funciona como cabr\xEDa esperar, simplemente
      toca el \xE1rea central y se abrir\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 412884417302528
    m_Localized: Las puertas azules, por otro lado, no se pueden abrir normalmente.
    m_Metadata:
      m_Items: []
  - m_Id: 412982119419904
    m_Localized: "Si puede encontrar una terminal de acceso, deber\xEDa poder abrir
      estas puertas."
    m_Metadata:
      m_Items: []
  - m_Id: 413095067832320
    m_Localized: El guardia se acerca, te toca. Buena suerte, agente.
    m_Metadata:
      m_Items: []
  - m_Id: 22367388935049216
    m_Localized: "\xA1Escapar!"
    m_Metadata:
      m_Items: []
  - m_Id: 22367773938601984
    m_Localized: "Encuentra una manera de escapar de la instalaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 22367938804109312
    m_Localized: Mantenga un perfil bajo...
    m_Metadata:
      m_Items: []
  - m_Id: 22368139904208896
    m_Localized: Escapar sin avisar a seguridad
    m_Metadata:
      m_Items: []
  - m_Id: 22368273358573568
    m_Localized: "CV el Guardi\xE1n"
    m_Metadata:
      m_Items: []
  - m_Id: 22369034335342592
    m_Localized: "\xA1Causa algo de caos!"
    m_Metadata:
      m_Items: []
  - m_Id: 22369325063524352
    m_Localized: "Acompa\xF1ar al VIP hasta la salida"
    m_Metadata:
      m_Items: []
  - m_Id: 22369412472819712
    m_Localized: "La \xFAnica forma que conoces... \xA1con cond\xF3n!"
    m_Metadata:
      m_Items: []
  - m_Id: 22369813393756160
    m_Localized: Excelente trabajo, agente. Nos vemos al otro lado.
    m_Metadata:
      m_Items: []
  - m_Id: 22370233231003648
    m_Localized: "Si te animas tenemos una petici\xF3n para ti."
    m_Metadata:
      m_Items: []
  - m_Id: 22370418040426496
    m_Localized: "Hay un VIP en una celda cerca de ti.\nTr\xE1elo contigo si puedes."
    m_Metadata:
      m_Items: []
  - m_Id: 22370646848098304
    m_Localized: "Aunque esto har\xE1 que tu escape sea dif\xEDcil..."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
