  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: PrisonBreakMod_hu
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: hu
  m_SharedData: {fileID: 11400000, guid: 09105430001d7424a9c35ff9ec274c87, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 159430135808
    m_Localized: Prison Break
    m_Metadata:
      m_Items: []
  - m_Id: 253495791616
    m_Localized: "Miut\xE1n elkapta a GlorpCo, meg kell sz\xF6knie!"
    m_Metadata:
      m_Items: []
  - m_Id: 519808929792
    m_Localized: "Kit\xF6r\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 411806946742272
    m_Localized: "\xDCgyn\xF6k, hall engem? Ki kell menned onnan."
    m_Metadata:
      m_Items: []
  - m_Id: 412025037967360
    m_Localized: "Meg sem fogom k\xE9rdezni, hogyan szerezte meg a kommunik\xE1tor\xE1t
      a biztons\xE1gon..."
    m_Metadata:
      m_Items: []
  - m_Id: 412350331408384
    m_Localized: "Egy tiszt j\xF6n kihallgatni, ez lesz a jegye a cell\xE1b\xF3l."
    m_Metadata:
      m_Items: []
  - m_Id: 412490337275904
    m_Localized: "Vigy\xE1zat, a biztons\xE1g itt egy kicsit m\xE1s, mint amit megszokt\xE1l."
    m_Metadata:
      m_Items: []
  - m_Id: 412565033635840
    m_Localized: "B\xE1rmely z\xF6ld ajt\xF3 \xFAgy m\u0171k\xF6dik, ahogy elv\xE1rn\xE1,
      egyszer\u0171en \xE9rintse meg a k\xF6zponti ter\xFCletet, \xE9s kiny\xEDlik."
    m_Metadata:
      m_Items: []
  - m_Id: 412884417302528
    m_Localized: "A k\xE9k ajt\xF3k viszont nem nyithat\xF3k rendesen."
    m_Metadata:
      m_Items: []
  - m_Id: 412982119419904
    m_Localized: "Ha tal\xE1l hozz\xE1f\xE9r\xE9si termin\xE1lt, akkor ezeket az
      ajt\xF3kat ki kell nyitnia."
    m_Metadata:
      m_Items: []
  - m_Id: 413095067832320
    m_Localized: "Az \u0151r k\xF6zeledik, fel vagy.\nSok sikert \xFCgyn\xF6k."
    m_Metadata:
      m_Items: []
  - m_Id: 22367388935049216
    m_Localized: "Menek\xFCl\xE9s!"
    m_Metadata:
      m_Items: []
  - m_Id: 22367773938601984
    m_Localized: "Tal\xE1lja meg a m\xF3dj\xE1t, hogy elker\xFClje a l\xE9tes\xEDtm\xE9nyt"
    m_Metadata:
      m_Items: []
  - m_Id: 22367938804109312
    m_Localized: Maradjon alacsony profil...
    m_Metadata:
      m_Items: []
  - m_Id: 22368139904208896
    m_Localized: "Menek\xFCl\xE9s a biztons\xE1gi figyelmeztet\xE9s n\xE9lk\xFCl"
    m_Metadata:
      m_Items: []
  - m_Id: 22368273358573568
    m_Localized: "\xD6n\xE9letrajz a fel\xFCgyel\u0151"
    m_Metadata:
      m_Items: []
  - m_Id: 22369034335342592
    m_Localized: "Okozzon n\xE9mi k\xE1oszt!"
    m_Metadata:
      m_Items: []
  - m_Id: 22369325063524352
    m_Localized: "K\xEDs\xE9rje a VIP-t a kij\xE1rathoz"
    m_Metadata:
      m_Items: []
  - m_Id: 22369412472819712
    m_Localized: "Csak \xFAgy tudod, hogyan... \xF3vszerk\xE9nt!"
    m_Metadata:
      m_Items: []
  - m_Id: 22369813393756160
    m_Localized: "Kiv\xE1l\xF3 munka\xFCgyn\xF6k. Viszl\xE1t a m\xE1sik oldalon."
    m_Metadata:
      m_Items: []
  - m_Id: 22370233231003648
    m_Localized: "Ha k\xE9szen \xE1ll r\xE1, van egy k\xE9r\xE9s\xFCnk."
    m_Metadata:
      m_Items: []
  - m_Id: 22370418040426496
    m_Localized: "A VIP egy k\xF6zeli cell\xE1ban van.\nHa teheti, hozza mag\xE1val
      \u0151ket. "
    m_Metadata:
      m_Items: []
  - m_Id: 22370646848098304
    m_Localized: "B\xE1r ez megnehez\xEDti a menek\xFCl\xE9st..."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
